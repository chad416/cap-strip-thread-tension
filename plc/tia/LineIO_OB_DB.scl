// TIA Portal only. The Python translator handles FBs only and does not run this file.
// Generated by scripts/gen_tia_sources.py; edit that script, not this file.
// scripts/tia_build.ps1 generates the four FBs from ../FB_*.scl, then scripts/tia_ob30.ps1
// generates this file and turns "Cyclic_CapStrip" into a cyclic-interrupt OB30 at 10 ms.
// "LineIO" stands in for the line's I/O mapping (DOSSIER section 6, interface table).

DATA_BLOCK "LineIO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR
      // IF-04 operator (HMI)
      StartReq : Bool;
      StopReq : Bool;
      JogReq : Bool;
      Ack : Bool;
      ClosedLoop : Bool := TRUE;
      Tset : Real := 15.0;   // N per cord at the template entrance (recipe)
      Trecipe : Real := 40.0;   // N strip tension at the winder (recipe)
      Taper : Real := 0.2;
      NewBobbin : Array[1..8] of Bool;
      NewSpool : Bool;
      DaqRelease : Bool;
      // IF-07 safety relay feedback
      EStopOk : Bool;
      // IF-01 tension sensors, IF-02 brake amplifiers, IF-03 spindle encoders
      Tension : Array[1..8] of Real;   // N
      TensionOk : Array[1..8] of Bool;
      BreakSwitch : Array[1..8] of Bool;
      Omega : Array[1..8] of Real;   // rad/s
      BrakeCurrent : Array[1..8] of Real;   // 0..1 of full scale, to the amplifiers
      Radius : Array[1..8] of Real;   // m, diameter estimate (HMI)
      Tvirtual : Array[1..8] of Real;   // N, model-based tension (HMI, plausibility)
      // IF-05 winder drive and strip load cell
      OmegaW : Real;   // rad/s
      StripT : Real;   // N
      StripTOk : Bool;
      WinderTorque : Real;   // N m, torque set point
      // IF-06 capstan drive and rubberising head
      SpeedRef : Real;   // m/s to the capstan drive
      DiePressure : Real;   // bar
      DieTemp : Real;   // degC
      // status
      LineMode : Int;
      BreakThread : Int;
      SlackFlag : Bool;
   END_VAR

BEGIN

END_DATA_BLOCK

