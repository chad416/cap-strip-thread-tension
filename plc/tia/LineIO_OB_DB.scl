ORGANIZATION_BLOCK "Cyclic_CapStrip"
TITLE = Cap-strip line: unwind brakes, winder, supervisor and data collection, every 10 ms
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	// modes, speed ramp, break and slack detection (uses the radii of the previous cycle)
	"iSUP"(StartReq := "LineIO".StartReq,
	       StopReq := "LineIO".StopReq,
	       JogReq := "LineIO".JogReq,
	       EStopOk := "LineIO".EStopOk,
	       Ack := "LineIO".Ack,
	       Tension := "LineIO".Tension,
	       TensionOk := "LineIO".TensionOk,
	       BreakSwitch := "LineIO".BreakSwitch,
	       Omega := "LineIO".Omega,
	       Radius := "LineIO".Radius,
	       ClosedLoop := "LineIO".ClosedLoop,
	       Tset := "LineIO".Tset);
	"LineIO".SpeedRef := "iSUP".SpeedRef;
	"LineIO".LineMode := "iSUP".LineMode;
	"LineIO".BreakThread := "iSUP".BreakThread;
	"LineIO".SlackFlag := "iSUP".SlackFlag;

	"iBrake1"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[1],
	          Tmeas := "LineIO".Tension[1],
	          TmeasOk := "LineIO".TensionOk[1],
	          NewBobbin := "LineIO".NewBobbin[1],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[1] := "iBrake1".CurrentCmd;
	"LineIO".Radius[1] := "iBrake1".Radius;
	"LineIO".Tvirtual[1] := "iBrake1".Tvirtual;

	"iBrake2"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[2],
	          Tmeas := "LineIO".Tension[2],
	          TmeasOk := "LineIO".TensionOk[2],
	          NewBobbin := "LineIO".NewBobbin[2],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[2] := "iBrake2".CurrentCmd;
	"LineIO".Radius[2] := "iBrake2".Radius;
	"LineIO".Tvirtual[2] := "iBrake2".Tvirtual;

	"iBrake3"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[3],
	          Tmeas := "LineIO".Tension[3],
	          TmeasOk := "LineIO".TensionOk[3],
	          NewBobbin := "LineIO".NewBobbin[3],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[3] := "iBrake3".CurrentCmd;
	"LineIO".Radius[3] := "iBrake3".Radius;
	"LineIO".Tvirtual[3] := "iBrake3".Tvirtual;

	"iBrake4"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[4],
	          Tmeas := "LineIO".Tension[4],
	          TmeasOk := "LineIO".TensionOk[4],
	          NewBobbin := "LineIO".NewBobbin[4],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[4] := "iBrake4".CurrentCmd;
	"LineIO".Radius[4] := "iBrake4".Radius;
	"LineIO".Tvirtual[4] := "iBrake4".Tvirtual;

	"iBrake5"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[5],
	          Tmeas := "LineIO".Tension[5],
	          TmeasOk := "LineIO".TensionOk[5],
	          NewBobbin := "LineIO".NewBobbin[5],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[5] := "iBrake5".CurrentCmd;
	"LineIO".Radius[5] := "iBrake5".Radius;
	"LineIO".Tvirtual[5] := "iBrake5".Tvirtual;

	"iBrake6"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[6],
	          Tmeas := "LineIO".Tension[6],
	          TmeasOk := "LineIO".TensionOk[6],
	          NewBobbin := "LineIO".NewBobbin[6],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[6] := "iBrake6".CurrentCmd;
	"LineIO".Radius[6] := "iBrake6".Radius;
	"LineIO".Tvirtual[6] := "iBrake6".Tvirtual;

	"iBrake7"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[7],
	          Tmeas := "LineIO".Tension[7],
	          TmeasOk := "LineIO".TensionOk[7],
	          NewBobbin := "LineIO".NewBobbin[7],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[7] := "iBrake7".CurrentCmd;
	"LineIO".Radius[7] := "iBrake7".Radius;
	"LineIO".Tvirtual[7] := "iBrake7".Tvirtual;

	"iBrake8"(BrakeMode := "iSUP".BrakeMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          Omega := "LineIO".Omega[8],
	          Tmeas := "LineIO".Tension[8],
	          TmeasOk := "LineIO".TensionOk[8],
	          NewBobbin := "LineIO".NewBobbin[8],
	          Tset := "LineIO".Tset);
	"LineIO".BrakeCurrent[8] := "iBrake8".CurrentCmd;
	"LineIO".Radius[8] := "iBrake8".Radius;
	"LineIO".Tvirtual[8] := "iBrake8".Tvirtual;

	"iWinder"(WinderMode := "iSUP".WinderMode,
	          LineSpeed := "iSUP".SpeedRef,
	          LineAccel := "iSUP".AccelRef,
	          OmegaW := "LineIO".OmegaW,
	          StripT := "LineIO".StripT,
	          StripTOk := "LineIO".StripTOk,
	          NewSpool := "LineIO".NewSpool,
	          Trecipe := "LineIO".Trecipe,
	          Taper := "LineIO".Taper);
	"LineIO".WinderTorque := "iWinder".TorqueCmd;

	// topic task 1: data of brakes and winder, capture around a thread break
	"iDAQ"(Tension := "LineIO".Tension,
	       Current := "LineIO".BrakeCurrent,
	       Radius := "LineIO".Radius,
	       StripTension := "LineIO".StripT,
	       WinderTorque := "LineIO".WinderTorque,
	       LineSpeed := "iSUP".SpeedRef,
	       LineMode := "iSUP".LineMode,
	       DiePressure := "LineIO".DiePressure,
	       DieTemp := "LineIO".DieTemp,
	       Trigger := "iSUP".Trigger,
	       TriggerThread := "iSUP".BreakThread,
	       SlackFlag := "iSUP".SlackFlag,
	       Release := "LineIO".DaqRelease,
	       Tset := "LineIO".Tset);
END_ORGANIZATION_BLOCK
